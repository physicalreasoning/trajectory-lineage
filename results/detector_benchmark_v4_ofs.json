{
  "config": {
    "_detector_mode": "ofs",
    "background_clips": 500,
    "background_top_k": 10,
    "calibration_rule": "one threshold per detector and operating point: the higher-method (1 - alpha) quantile of pooled calibration easy-negative query scores across all transforms; a query is removed when its score strictly exceeds the threshold",
    "claim_boundary": "Synthetic collisions rendered natively at 224 px; full 24-frame clips compared with full training clips (curation setting). Results characterize detector behavior on provenance ground truth; they do not measure exposure effects and do not transfer automatically to the 64 px, 8-frame model inputs.",
    "clip_frames": 24,
    "detectors": {
      "centroid_invariant": "centroid tracks searched over mirroring and integer time offsets up to 3 frames (overlapping frames only)",
      "centroid_motion": "two-color foreground centroid tracks, negative RMS distance; extraction failure never matches",
      "dinov2_aligned": "DINOv2 frame embeddings, mean of time-aligned per-frame cosines",
      "dinov2_aligned_norm": "dinov2_aligned with the same background normalization",
      "dinov2_pooled": "DINOv2 ViT-S/14 CLS embeddings on native 224 px frames, mean-pooled, cosine",
      "exact_hash": "SHA-256 of clip bytes",
      "oracle_state": "privileged state-distance reference: negative RMS state distance from simulator records (not a provenance oracle)",
      "raft_flow": "torchvision RAFT-small flow between sampled frames at native 224 px, 8x8 average-pooled field, cosine",
      "raft_flow_invariant": "RAFT flow descriptor searched over mirroring (grid flip, negated x-flow) and offsets up to 1 sampled step",
      "raft_flow_norm": "raft_flow with the same background normalization",
      "silhouette": "color-invariant 8x8 foreground occupancy per frame, negative RMS distance",
      "sscd_aligned": "SSCD frame embeddings, mean of time-aligned per-frame cosines",
      "sscd_aligned_norm": "sscd_aligned minus the query's mean top-10 similarity to 500 unrelated background clips (VSC-style score normalization)",
      "sscd_pooled": "SSCD sscd_disc_mixup frame embeddings on native 224 px frames, mean-pooled, cosine"
    },
    "easy_negative_queries": 600,
    "frame_dt": 0.04,
    "gallery_trajectories": 500,
    "hard_negative_band": {
      "box_multiplier": 6.0,
      "construction": "independent event conditioned on RMS state distance in [0.25, 0.5] x the target's nearest other-gallery distance (sensitivity-scaled box proposals, multiplier 6)",
      "high_fraction": 0.5,
      "low_fraction": 0.25
    },
    "hard_negative_queries": 200,
    "image_size": 224,
    "interpretive_gate": "Conclusions about a perceptual detector on trajectory reuse require it to pass the copy_reencode positive control: AUROC versus easy negatives >= 0.95 and recall >= 0.80 at the 5% operating point. Detectors failing the gate are reported as not functional in this domain. The gate is necessary, not sufficient: it certifies re-encoding robustness only, not competence under the other transformations.",
    "invariant_max_shift_flow_steps": 1,
    "invariant_max_shift_frames": 3,
    "learned_frame_indices": [
      0,
      3,
      6,
      9,
      12,
      15,
      18,
      21
    ],
    "metrics": [
      "same-trajectory recall per transform",
      "easy-negative false removal per transform",
      "hard-negative (similarity-selected nearby) false removal per transform",
      "AUROC positives vs easy negatives and vs hard negatives",
      "top-1 source retrieval accuracy for removed positives",
      "extraction failures",
      "Wilson 95% intervals",
      "tie-aware (mid-rank) median rank and top-1 rate of the true source among gallery items",
      "per-transform easy-negative false removal (calibration transfer)"
    ],
    "name": "detector_benchmark_v4",
    "operating_points": [
      0.01,
      0.05
    ],
    "outputs": "results/detector_benchmark_v4.json, results/detector_benchmark_v4_scores.json.gz, results/detector_benchmark_v4_analysis.json",
    "positive_queries": 200,
    "provenance": "git commit, dirty flag, config SHA-256, and model sources are recorded in the result",
    "purpose": "Measure whether exact, perceptual, and motion-based duplicate detectors recognize same-trajectory rerenders under stress transformations while sparing independent and similarity-selected nearby events, at query-level false-removal rates calibrated on separate families.",
    "query_score": "maximum similarity over the full training gallery",
    "registered_expectations": [
      "All perceptual detectors achieve high recall on the copy_reencode positive control.",
      "Exact hashing has near-zero recall under every transform except none.",
      "On appearance-changed rerenders, generic perceptual descriptors (SSCD, DINOv2) are far weaker than on copies, because trajectory identity is carried by small positional differences in visually homogeneous scenes.",
      "Motion descriptors recover appearance-only rerenders; invariance search recovers mirror and time-shift recall at some cost in false removal.",
      "Closer-than-gallery hard negatives produce higher false removal than easy negatives for motion and state-based detectors."
    ],
    "simulated_frames": 27,
    "size_note": "Easy negatives reduced from 1000 to 600 per transform before running (native 224 px is ~3.8x slower); pooled calibration still uses 4,800 negatives.",
    "splits": {
      "calibration": 2026101731,
      "test": 2026101732
    },
    "status": "registered_before_run",
    "supersedes": "v3 hard negatives were drawn with the superseded half-range-capped box (the sampler fix landed after the v3 process had loaded the old code), so v3 does not reproduce from current code; v3 copy-control negatives also had fresh appearances, so the control could reward palette matching. v3 results are preserved as results/detector_benchmark_v3*.",
    "time_shift_frames": 3,
    "track_validation": "Centroid tracks are compared with simulator positions mapped through each transformation (median RMSE in pixels, fraction within 2 px, extraction failures).",
    "transforms": {
      "appearance": "new palette and background color",
      "compression": "appearance plus per-frame JPEG at quality 25",
      "copy_reencode": "positive control: the identical gallery render re-encoded as JPEG q75. Copy-control hard negatives use their target gallery clip's appearance and easy negatives a random gallery clip's appearance, so passing requires trajectory discrimination, not palette matching.",
      "crop": "appearance plus central 80% crop resized to full resolution",
      "distractor": "appearance plus a third moving disk (radius and speed scaled with resolution)",
      "mirror": "appearance plus horizontal mirroring",
      "texture": "appearance plus a static random background texture",
      "time_shift": "appearance plus a 3-frame (0.12 s) temporal offset"
    }
  },
